# Copy to .env.local and fill in values for the target lab environment.

export DBS_NODES="dbnode01.example.com,dbnode02.example.com"
export CELLS_NODES="cell01.example.com,cell02.example.com,cell03.example.com"
export CELLS_USER="celladmin"

export LAB_DB_HOST="dbnode01.example.com"
export LAB_ORACLE_HOME="/u01/app/oracle/product/23.26.2.0/db_home_1"
export LAB_ORACLE_SID="cdb1"
export LAB_JAVA_HOME=""
export LAB_SQL_CLIENT="auto"

# Keep real passwords only in ignored .env.* files.
export PDB_ADMIN_PASSWORD=""

# Lab 04: gDBClone full-CDB thin clone inputs.
# Keep the encrypted SYS password file protected. Do not store the SYS password here.
export GDBCLONE_HOME="/opt/gDBClone"
export GDBCLONE_BIN="$GDBCLONE_HOME/gDBClone.bin"
export LAB04_SUDO_BIN="sudo"
# Set this to the DB_UNIQUE_NAME of the CDB used for Labs 01 and 02. Use a
# different value only when intentionally cloning another CDB.
export LAB04_SOURCE_DB_UNIQUE_NAME=""
# Set the target DB_NAME: 1 to 8 alphanumeric characters, beginning with a
# letter. This value is passed to gDBClone as --tdbname.
export LAB04_TARGET_DB_NAME=""
# Set a new, unique DB_UNIQUE_NAME for the CDB thin clone. This is passed as
# --tdbuniquename and can include underscores.
export LAB04_TARGET_DB_UNIQUE_NAME=""
# Prefix each cloned PDB with a value unique to this target CDB. This renames
# their default services as well. For example: C8DB9_.
export LAB04_TARGET_PDB_PREFIX=""
# Optional comma-separated target RAC instance names for the Clusterware-managed
# PDB services. When empty, Lab 04 derives them from srvctl config database.
export LAB04_RAC_SERVICE_PREFERRED=""
export LAB04_RAC_MODE="2"
# Optional target SGA values in MB. When empty, gDBClone inherits the source
# CDB values. Set one or both only when intentionally overriding the source.
export LAB04_SGA_TARGET_MB=""
export LAB04_SGA_MAX_SIZE_MB=""
# Comma-separated target VM-cluster database server VMs that will host the
# target CDB. Do not specify underlying KVM hosts. The preflight checks free
# hugepages on every listed VM.
export LAB04_TARGET_DB_NODES=""
# Warn and stop when a finite Exascale vault media allocation has this much
# free capacity remaining. Values are percentages.
export LAB04_VAULT_WARN_FREE_PCT="20"
export LAB04_VAULT_ERROR_FREE_PCT="10"
# Leave empty to use lab-04-cdb-thin-clones/SYSpasswd_file. Set a protected
# absolute path only when intentionally overriding the Lab 04 default.
export LAB04_SYS_PASSWORD_FILE=""
# Administrative CDB$ROOT connection used to verify the source before cloning.
export LAB04_SOURCE_DB_CONNECT="/ as sysdba"
# Administrative CDB$ROOT connection used to verify the target after cloning.
export LAB04_TARGET_DB_CONNECT=""
export LAB04_SQL_CLIENT="auto"
